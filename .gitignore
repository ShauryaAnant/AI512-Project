# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Data and dataset directories (ACDC images and labels must NEVER be committed per license)
dataset/
data/raw/
