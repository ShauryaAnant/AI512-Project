*.pth
*.pt
*.onnx
*.bin

# Runs and checkpoints (keep metrics.csv and results.json, ignore large dumps)
runs/*/checkpoints/
runs/*/eval/preds/
runs/*/eval/color_preds/
runs/*/*.pth
runs/*/*.log

